    "\n",
    "# NOTE: overhead debug plot is NOT here -- deferred to after the chirp (change #2)\n",
    "\n",
    "_first_images_done = Event()   # i>0 save threads wait on this before symlinking\n",
    "_first_sample_dir = base_sample_dir / sample_ids[0]\n",
    "save_threads = []\n",
    "_first_raw_vibration = None\n",
    "\n",
    "\n",
    "def save_sample(i, speaker, sample_id, raw_vibration):\n",
