    "    # change #1: fire segmentation async, DO NOT WAIT\n",
    "    _seg_future = _pool.submit(\n",
    "        lambda: unpack_masks(segmenter.run.remote(_jpeg, prompts, top_k=[freq for freq in objects.values()]))\n",
    "    ) if objects else None\n",
    "    overhead_ready.set()\n",
    "\n",
    "if OVERLAP_OVERHEAD:\n",
    "    with _sw.span(\"spawn overhead+segment prep (overlaps spk-0 capture)\"):\n",
