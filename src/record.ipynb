    "#    _speaker_audio, _chirp_audio, audio_fs\n",
    "# =============================================================================\n",
    "from threading import Thread\n",
    "from datetime import datetime, timezone\n",
    "import json, time\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ---------------- params ----------------\n",
    "HAND_DELAY    = 0.1        # pause before the first capture (hand pulls back)\n",
    "SPEAKER_DELAY = 0.1        # pause before each speaker (box settles between takes)\n",
    "VIBRATE       = True       # play audio + run the capture loop; off = skip it\n",
    "SAVE          = True       # write samples to disk\n",
    "DEBUG         = True\n",
    "\n",
    "speakers    = [1, 3, 5, 7]\n",
    "box         = 'wood'\n",
    "objects     = {'red-cube': 1}\n",
    "layout      = 'one-cube-grid1'\n",
    "description  = \"A metal cube sitting on the floor of an closed wood box from a bird's eye view.\"\n",
    "\n",
    "laser_idx, pclk_batch_size, use_PC, segment_scale = 9, 256, True, 1.0\n",
    "\n",
    "\n",
    "class Task(Thread):\n",
    "    \"\"\"Run fn() on a thread; its return value is on .result after .join().\"\"\"\n",
    "    def __init__(self, fn): super().__init__(daemon=True); self.fn, self.result = fn, None\n",
    "    def run(self): self.result = self.fn()\n",
    "\n",
    "\n",
    "def capture_vibrations(cam, n, h, w):          # n frames; grabber already running\n",
    "    t = CaptureFrameThread2(cam, n, h, w)\n",
    "    t.start(); t.join()\n",
    "    return t.read()[0]\n",
    "\n",
    "\n",
    "# ---------------- run ----------------\n",
    "t0 = time.perf_counter()\n",
    "prompts     = [PROMPTS[o] for o in objects]\n",
    "position_id = get_position_id(positions_file)\n",
    "n0          = count_dirs(base_sample_dir)\n",
    "sample_ids  = [f\"{n0 + k:06d}\" for k in range(len(speakers))]\n",
    "d0          = base_sample_dir / sample_ids[0]\n",
    "\n",
    "time.sleep(HAND_DELAY)\n",
    "\n",
    "def segment_overhead():                         # -> (raw_overhead, crop_overhead, seg_call)\n",
    "    raw = capture_overhead(overhead_cam)[0]\n",
    "    crop_overhead = crop(raw, **CROP_PARAMS[box])\n",
    "    seg_call = segmenter.run.spawn(to_jpeg_bytes(crop_overhead), prompts,\n",
    "                                   top_k=list(objects.values())) if objects else None\n",
    "    return raw, crop_overhead, seg_call\n",
    "segment_thread = Task(segment_overhead); segment_thread.start()\n",
    "\n",
    "def save_metadata(speaker, sample_id, raw_vibration):   # bg thread, one per speaker, shares nothing\n",
    "    segment_thread.join()\n",
    "    raw_overhead, crop_overhead, seg_call = segment_thread.result\n",
    "    seg_results = unpack_masks(seg_call.get()) if seg_call else []\n",
    "    coms = [[center_of_mass(m) for m in r['masks']] for r in seg_results]\n",
    "    avg_com = np.mean([c for r in coms for c in r], axis=0).tolist() if any(coms) else []\n",
    "    smask = np.any([m for r in seg_results for m in r['masks']], axis=0) if seg_results else np.zeros(crop_overhead.shape[:2], bool)\n",
    "\n",
    "    d = base_sample_dir / sample_id\n",
    "    d.mkdir(parents=True, exist_ok=True)\n",
    "    symlink(audio_dir, d / 'audio')             # link to the shared audio dir (not an image)\n",
    "    update_position(positions_file, position_id, sample_id)\n",
    "\n",
    "    id_params           = dict(sample_id=sample_id, position_id=position_id, speaker=speaker, experiment_dir=experiment_dir, timestamp=datetime.now(timezone.utc).isoformat())\n",
    "    object_params       = dict(box=box, n_objects=sum(objects.values()), objects=objects, layout=layout, description=description, is_empty_box=len(objects) == 0)\n",
    "    audio_params        = dict(audio_dir=audio_dir, audio_fs=audio_fs, min_freq=MIN_FREQ, max_freq=MAX_FREQ)\n",
    "    segment_params      = dict(prompts=prompts, seg_results=seg_results, coms=coms, avg_com=avg_com, segment_scale=segment_scale)\n",
    "    laser_camera_params = dict(height=cam_h, width=cam_w, n_frames=n_frames, n_capture_seconds=n_capture_seconds, fps=FPS, expose=EXPOSURE, gain=GAIN, buffer_part_count=BUFFER_PART_COUNT)\n",
    "    laser_params        = dict(power=500, n_rows=10, n_cols=10, rois=run_opt_multiROIs['ROIs'], run_opt=run_opt, run_opt_multiROIs=run_opt_multiROIs)\n",
    "    pclk_params         = dict(pclk_batch_size=pclk_batch_size, use_PC=use_PC, laser_idx=laser_idx)\n",
    "    params = id_params | object_params | audio_params | segment_params | laser_camera_params | laser_params | pclk_params\n",
    "    with open(d / 'metadata.jsonl', 'w', encoding='utf-8') as f:\n",
    "        for k, v in params.items(): f.write(json.dumps({k: v}, default=str) + '\\n')\n",
    "\n",
    "    save(raw_overhead,  d / 'image/01_raw_overhead.png')\n",
    "    save(crop_overhead, d / 'image/02_cropped_overhead.png')\n",
    "    save(smask, d / 'image/03_smask.npy'); save(smask, d / 'image/03_smask.png')\n",
    "    for (obj, _), r in zip(objects.items(), seg_results):\n",
    "        for j, m in enumerate(r['masks']): save(m, d / f'image/smasks/{obj}{j}.npy')\n",
    "    save(raw_vibration, d / 'vibration/01_raw_vibrations.npy')\n",
    "\n",
    "jobs, vib0 = [], None\n",
    "if VIBRATE:\n",
    "    cam.grabber.flush_buffers(); cam.grabber.start()\n",
    "    try:\n",
    "        for i, speaker in enumerate(speakers):\n",
    "            print(f'position {position_id}, speaker {speaker} (sample {sample_ids[i]})')\n",
    "            time.sleep(SPEAKER_DELAY)\n",
    "            play_audio(_speaker_audio, speaker, wait=False)\n",
    "            vib = capture_vibrations(cam, n_frames, cam_h, cam_w)\n",
    "            if i == 0: vib0 = vib\n",
    "            if SAVE:\n",
    "                t = Thread(target=save_metadata, args=(speaker, sample_ids[i], vib), daemon=True)\n",
    "                t.start(); jobs.append(t)\n",
    "    finally:\n",
    "        cam.grabber.stop(); cam.grabber.flush_buffers()\n",
    "\n",
    "print(f'time to chirp: {time.perf_counter() - t0:.2f}s')\n",
    "play_audio(_chirp_audio, [1, 2, 3, 4, 5, 6, 7, 8], wait=False)        # <-- done. ~5.7s to here.\n",
    "\n",
    "if DEBUG:                                       # off the clock: plots only\n",
    "    t_debug = time.perf_counter()\n",
    "    segment_thread.join()\n",
    "    _, crop_overhead, seg_call = segment_thread.result\n",
    "    seg_results = unpack_masks(seg_call.get()) if seg_call else []\n",
    "    smask = np.any([m for r in seg_results for m in r['masks']], axis=0) if seg_results else np.zeros(crop_overhead.shape[:2], bool)\n",
    "    if layout in coverage and coverage[layout][0].shape != smask.shape: del coverage[layout]\n",
    "    coverage[layout] = (coverage[layout][0] + smask, coverage[layout][1] + len(speakers)) if layout in coverage else (smask, len(speakers))\n",
    "\n",
    "    fig, axs = plt.subplots(1, 3, figsize=(18, 6))\n",
    "    plot_overhead(seg_results, crop_overhead, ax=axs[0]); plot_smask(seg_results, crop_overhead, ax=axs[1])\n",
    "    plot_coverage(coverage, layout, ax=axs[2])\n",
    "    fig.suptitle(f'overhead: position {position_id}'); plt.show()\n",
    "\n",
    "    if vib0 is not None:\n",
    "        raw_shift = pclk(vib0, run_opt_multiROIs['ROIs'], pclk_batch_size, laser_idx=laser_idx, use_PC=use_PC)\n",
    "        fft, freqs, n_samples = compute_fft(raw_shift, FPS)\n",
    "        fig, axs = plt.subplots(2, 1, figsize=(18, 6))\n",
    "        plot_shifts(raw_shift, FPS, laser_idx, ax=axs[0]); plot_fft_magnitude(fft, freqs, laser_idx, ax=axs[1])\n",
    "        fig.suptitle(f'vibration: position {position_id}, speaker {speakers[0]} (sample {sample_ids[0]})'); plt.show()\n",
    "        if SAVE:\n",
    "            save(raw_shift, d0 / 'vibration/02_raw_shift.npy')\n",
    "            save(dict(fft=fft, freqs=freqs, n_samples=n_samples), d0 / 'vibration/03_fft.npz')\n",
    "    print(f'debug: {time.perf_counter() - t_debug:.2f}s')\n",
    "\n",
    "for t in jobs: t.join()\n",
    "print(f'total time: {time.perf_counter() - t0:.2f}s')\n"
