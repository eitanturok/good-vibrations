    "# =============================================================================\n",
    "#  OPTIMIZED copy of record.ipynb cell 70  (\"Run Experiment\")\n",
    "#\n",
    "#  Same outputs as the original (identical files on disk, identical debug\n",
    "#  figures) but the whatsapp chirp fires as soon as the LAST laser capture is\n",
    "#  done. All matplotlib rendering + the pclk sanity check + all disk writes are\n",
    "#  moved off the hot path.\n",
    "#\n",
    "#  Paste as a NEW cell in 4record.ipynb after your setup cells. Same namespace\n",
    "#  requirements as instrumented_cell_70.py. Keeps its own _sw timer so you can\n",
    "#  compare directly.\n",
    "#\n",
    "#  Changes vs original (see CHANGES.md for measured speedups):\n",
    "#    #1  segmentation submitted to a thread, overlaps speaker-0 capture (no wait)\n",
    "#    #2  every plt figure + pclk + fft DEFERRED to after the chirp\n",
    "#    #3  per-speaker metadata / image PNGs / vibration .npy all in bg threads\n",
    "#    #4  audio.wav + whatsapp chirp loaded ONCE, before the loop\n",
    "#    #5  sample ids counted once, incremented locally (no per-iter iterdir)\n",
    "#    #8  grabber.start()/stop() ONCE around the whole loop, not per speaker\n",
    "#        (real run: capture_N_frames = 1500 ms but 3250 frames @ 2500 fps is only\n",
    "#         1300 ms -> ~200 ms/call is flush+start+stop; do it 1x not 4x -> -600 ms)\n",
    "#    #9  prewarm play_audio + trim hand delay (freebies, ~-140 ms)\n",
    "# =============================================================================\n",
    "import time as _time\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "from threading import Event\n",
    "\n",
    "class _SW:\n",
    "    def __init__(self): self.rows=[]; self.t0=_time.perf_counter()\n",
    "    def span(self, label):\n",
    "        sw=self\n",
    "        class _C:\n",
    "            def __enter__(self): self.t=_time.perf_counter()\n",
    "            def __exit__(self,*a):\n",
    "                dt=_time.perf_counter()-self.t; sw.rows.append((label,dt))\n",
    "                print(f\"  [{dt*1000:8.1f} ms]  {label}\")\n",
    "        return _C()\n",
    "    def done(self):\n",
    "        dt=_time.perf_counter()-self.t0\n",
    "        print(\"  \"+\"=\"*46); print(f\"  [{dt*1000:8.1f} ms]  TOTAL to whatsapp chirp\")\n",
    "        print(\"\\n===== TIMING TABLE (copy this back) =====\")\n",
    "        for l,d in self.rows: print(f\"{d*1000:9.1f} ms  {l}\")\n",
    "        print(f\"{'-'*46}\\n{dt*1000:9.1f} ms  TOTAL\")\n",
    "_sw=_SW()\n",
    "\n",
    "VIBRATE = True\n",
    "SAVE = True\n",
    "DEBUG = True\n",
    "\n",
    "# change #7: run the overhead capture + JPEG + segmentation submit in a bg thread\n",
    "# that overlaps speaker-0's laser capture. Overhead cam (pyueye) and laser cam\n",
    "# (egrabber) are separate devices with separate SDKs, so concurrent use from two\n",
    "# threads of THIS process is fine -- the \"one process only\" rule is about other\n",
    "# processes. Set False if you ever see a driver conflict; costs ~0.3 s.\n",
    "OVERLAP_OVERHEAD = True\n",
    "\n",
    "# change #8: keep the grabber running across all speakers (start/stop once).\n",
    "HAND_DELAY = 0.05          # change #9: was 0.1; only needs to cover your hand pulling back\n",
    "\n",
    "\n",
    "def capture_N_frames_warm(cam, N_frames, IMG_H, IMG_W):\n",
    "    \"\"\"capture_N_frames without the per-call grabber.start()/stop(). Assumes the\n",
    "    grabber is ALREADY started (done once before the loop). CaptureFrameThread2\n",
    "    blocks on full buffers, so the <1-buffer of frames that trickle in between\n",
    "    speakers just land at the very start of the clip (~40 ms, inside the\n",
    "    n_capture_seconds slack). Add cam.grabber.flush_buffers() as the first line\n",
    "    if BufferPartCount is 1 rather than 1625.\"\"\"\n",
    "    th = CaptureFrameThread2(cam, N_frames, IMG_H, IMG_W)\n",
    "    th.start(); th.join()\n",
    "    return th.read()\n",
    "\n",
    "box = 'wood'\n",
    "objects = {'red-cube': 1}\n",
    "layout = 'one-cube-grid1'\n",
    "description = f\"A metal cube sitting on the floor of an closed {box} box from a bird's eye view.\"\n",
    "prompts = [PROMPTS[o] for o in objects]\n",
    "if len(objects) == 0: layout, description = \"empty-box\", f\"An empty open {box} box from a bird's eye view.\"\n",
    "\n",
    "speakers = [1, 3, 5, 7]\n",
    "\n",
    "ROIs = run_opt_multiROIs['ROIs']\n",
    "laser_idx = 9\n",
    "pclk_batch_size = 256\n",
    "use_PC = True\n",
    "segment_scale = 1.0\n",
    "\n",
    "_pool = ThreadPoolExecutor(max_workers=8)\n",
    "\n",
    "# ---- change #4: load both wavs once, up front ----\n",
    "with _sw.span(\"preload audio.wav + whatsapp chirp\"):\n",
    "    _samples, _audio_fs_local = load(audio_dir / 'audio.wav')\n",
    "    _speaker_audio = _samples.astype(np.float32) / np.iinfo(_samples.dtype).max\n",
    "    if _speaker_audio.ndim > 1: _speaker_audio = _speaker_audio.mean(axis=1)\n",
    "    _chirp_path = Path(r'C:\\Users\\eitanturok\\good-vibrations\\data\\whatsapp-whistle.mp3')\n",
    "    _chirp_audio, _ = sf.read(_chirp_path, dtype=\"float32\", always_2d=True)\n",
    "    _chirp_audio = _chirp_audio.mean(axis=1)\n",
    "    play_audio(np.zeros(256, np.float32), speakers[0], wait=False)   # change #9: prewarm the audio path (~-40 ms off spk-0)\n",
    "\n",
    "# ---- change #5: count sample ids once ----\n",
    "with _sw.span(\"count base sample id once\"):\n",
    "    _base_count = count_dirs(base_sample_dir)\n",
    "    sample_ids = [f\"{_base_count + k:06d}\" for k in range(len(speakers))]\n",
    "\n",
    "with _sw.span(\"get_position_id\"):\n",
    "    position_id = get_position_id(positions_file)\n",
    "with _sw.span(\"hand delay\"):\n",
    "    time.sleep(HAND_DELAY)\n",
    "\n",
    "# raw_overhead / crop_overhead / _seg_future are produced by _overhead_prep(),\n",
    "# either inline (below) or in a bg thread that overlaps speaker-0's capture.\n",
    "raw_overhead = crop_overhead = _seg_future = None\n",
    "overhead_ready = Event()\n",
    "\n",
    "def _overhead_prep():\n",
    "    global raw_overhead, crop_overhead, _seg_future\n",
    "    raw_overhead, _ = capture_overhead(overhead_cam)\n",
